#!/usr/bin/env bash
#
# possiblaw — branded one-command launcher for the PossibLaw Paperclip-native
# Agent Companies package.
#
# Replaces bin/possiblaw-launch with two changes:
#   1. Variant selection (codex / claude / ollama / llamacpp / opencode /
#      openrouter, plus the codex-api / claude-api twins) via variants.yaml
#   2. Direct HTTP POST to /api/companies/import instead of the paperclipai CLI,
#      so we can use the full adapterOverrides schema (model + reasoning effort
#      + timeout per agent, keyed by metadata.possiblaw.modelLane).
#
# Run as:
#     ./bin/possiblaw [--variant <slug>] [--mission "…"] \
#                     [--org-name "…"] [--data-dir PATH] [--port N] \
#                     [--package PATH] [--reset] [--yes] [--dry-run] \
#                     [--list-variants] [--non-interactive] [--no-browser] [--theme <name>]
#
# Compatibility: macOS zsh / bash 3.2+. Requires pnpm, curl, python3,
# and the paperclip submodule. No jq required.

set -euo pipefail

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

SCRIPT_NAME="$(basename "$0")"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

DEFAULT_DATA_DIR="$HOME/.possiblaw/paperclip-data"
DEFAULT_PORT="3100"
DEFAULT_GATE_PORT="3801"
DEFAULT_PACKAGE="$REPO_ROOT/companies/legal-operations"
DEFAULT_VARIANTS_FILE="$DEFAULT_PACKAGE/variants.yaml"
DEFAULT_PAPERCLIP_YAML="$DEFAULT_PACKAGE/.paperclip.yaml"
PACKAGE_DEFAULT_ORG_NAME="PossibLaw Legal Operations"
HEALTH_TIMEOUT_SECS=60
HEALTH_POLL_INTERVAL_SECS=1
GATE_HEALTH_TIMEOUT_SECS=15
IMPORT_HEARTBEAT_SECS=10
IMPORT_PARTIAL_CHECK_AFTER_SECS=90
IMPORT_MAX_TIME_SECS=600

# Egress credentials live ONLY in the gate-proxy process. They are scrubbed
# from the env the paperclip server starts with (adapter-spawned agents
# inherit the SERVER's process env wholesale — codex-local execute.ts merges
# process.env into the spawned CLI env — so a token here would reach every
# agent and let it bypass the gate). LOCAL_MODEL_URL / EXTERNAL_MODEL_URL are
# endpoints, not credentials: they pass through to the proxy by inheritance
# and are harmless elsewhere.
EGRESS_CRED_VARS="MS_GRAPH_TOKEN GDRIVE_ACCESS_TOKEN NOTION_API_KEY GMAIL_TOKEN EXTERNAL_MODEL_API_KEY"

VARIANTS_PY="$SCRIPT_DIR/_possiblaw_variants.py"
INLINE_PY="$SCRIPT_DIR/_possiblaw_inline_source.py"
THEME_PY="$SCRIPT_DIR/_possiblaw_theme.py"

LAUNCH_START_EPOCH="$(date +%s)"

# ---------------------------------------------------------------------------
# Logging helpers
# ---------------------------------------------------------------------------

log()   { printf '[possiblaw] %s\n' "$*"; }
warn()  { printf '[possiblaw][warn] %s\n' "$*" >&2; }
err()   { printf '[possiblaw][error] %s\n' "$*" >&2; }
elapsed() { printf '%ss' "$(( $(date +%s) - LAUNCH_START_EPOCH ))"; }
milestone() { log "[$(elapsed)] $*"; }

usage() {
    cat <<USAGE
$SCRIPT_NAME — one-command launcher for PossibLaw on Paperclip

USAGE:
  $SCRIPT_NAME [options]

OPTIONS:
  --variant <slug>      Variant to apply at import: codex | codex-api |
                        claude | claude-api | ollama | llamacpp | opencode |
                        openrouter. If omitted, prompts.
                        Key-taking variants (codex-api, claude-api, opencode,
                        openrouter) bill an API key: export it (OPENAI_API_KEY,
                        ANTHROPIC_API_KEY, GEMINI_API_KEY, OPENCODE_API_KEY,
                        OPENROUTER_API_KEY)
                        before running; it is stored once as a paperclip
                        company secret, never in files.
                        Fully local variants: ollama (Ollama daemon) and
                        llamacpp (llama-server with an HF GGUF model).
  --mission <text>      Mission statement for the company (one line).
                        If omitted, the launcher prompts.
  --org-name <name>     Company name. Default: "$PACKAGE_DEFAULT_ORG_NAME".
  --data-dir <path>     Paperclip data directory.  Default: $DEFAULT_DATA_DIR
  --port <port>         Paperclip HTTP port.       Default: $DEFAULT_PORT
  --gate-port <port>    Gate-proxy HTTP port.      Default: $DEFAULT_GATE_PORT
  --no-gate-proxy       Demo-only: don't start the gate proxy and don't
                        inject GATE_PROXY_URL into agents. Live runs
                        normally start the proxy after import; egress
                        credentials (MS_GRAPH_TOKEN, GDRIVE_ACCESS_TOKEN,
                        NOTION_API_KEY, GMAIL_TOKEN, EXTERNAL_MODEL_API_KEY)
                        are ALWAYS scrubbed from the paperclip server env,
                        so agents reach vendors only through the proxy.
                        local_trusted instances accept unauthenticated board
                        calls; for any non-local-trusted deployment, export
                        PAPERCLIP_GATE_API_KEY (minted via 'paperclipai auth
                        login') before launching.
  --package <path>      Path to package source.    Default: $DEFAULT_PACKAGE
  --variants-file <path> variants.yaml path.       Default: <package>/variants.yaml
  --reset               Wipe the data directory before starting.
  --yes                 Skip confirmation prompts.
  --non-interactive     Never prompt. Requires --variant, --mission, --yes
                        (and a stable --org-name).
  --dry-run             POST to /api/companies/import/preview instead of /import.
                        Skips the model probe and secret creation.
  --list-variants       Print available variants from variants.yaml and exit.
  --skip-model-probe    Skip the preflight per-model CLI probe (codex/claude/
                        gemini variants probe each lane model with a tiny request so
                        "no access to model" errors surface before launch).
  --demo <profile>      Merge a synthetic demo profile's projects/tasks into
                        the import (companies/demos/<profile>): law-firm,
                        inhouse-legal, or biglaw-practice-group. Each profile's
                        README.md is the demo script. All demo data is fictional.
  --teams <list>        Import only the named teams (comma-separated lead
                        slugs without the -lead suffix, e.g.
                        "litigation,commercial"), plus the chiefs, the
                        capability builder, and the meta-reviewers, with the
                        skills they reference. Presets: "boutique"
                        (commercial, employment, litigation, real-estate,
                        family-law, estates + business teams) and "inhouse"
                        (commercial, employment, privacy, corporate,
                        regulatory, ai-governance + business teams).
                        Default: the full catalog. The catalog is the menu —
                        import what your firm practices; re-import to add
                        teams later.
  --theme <name>        UI look for the dashboard: possiblaw (default —
                        light-first with the warm PossibLaw palette), light
                        (paperclip's stock light theme as the default), or
                        dark (stock behavior, removes any overlay). Applies
                        to live launches; the in-app light/dark toggle in the
                        sidebar account menu always wins once a user sets it.
                        Env override: POSSIBLAW_THEME.
  --business <slug>     Firm identity slug. Overlays
                        businesses/<slug>/memory/firm-memory.md into the
                        firm-memory skill body at import, and sets
                        POSSIBLAW_BUSINESS_DIR on every agent so the
                        learning-loop scribe can locate the store.
                        If businesses/<slug>/ does not exist, it is created
                        from businesses/_template/ automatically.
  --no-browser          Don't auto-open the dashboard URL.
  -h, --help            Show this help and exit.

EXAMPLES:
  # Interactive — recommended for first run:
  ./bin/$SCRIPT_NAME

  # Non-interactive codex run:
  ./bin/$SCRIPT_NAME --variant codex \\
                     --org-name "Acme Legal" \\
                     --mission "Litigation-first commercial-disputes boutique" \\
                     --reset --yes --non-interactive

  # Preview without writing anything:
  ./bin/$SCRIPT_NAME --variant codex --dry-run --non-interactive --yes
USAGE
}

confirm() {
    local prompt="$1"
    local reply
    printf '%s [y/N]: ' "$prompt"
    if ! read -r reply; then return 1; fi
    case "$reply" in
        y|Y|yes|YES|Yes) return 0 ;;
        *) return 1 ;;
    esac
}

require_cmd() {
    local cmd="$1"
    local hint="$2"
    if ! command -v "$cmd" >/dev/null 2>&1; then
        err "Required command not found: $cmd"
        err "Install hint: $hint"
        return 1
    fi
    log "ok: $cmd found at $(command -v "$cmd")"
    return 0
}

# Read a JSON value off stdin via python3, dot-path notation.
# NOTE: must use `python3 -c`, NOT `python3 - <<heredoc` — the heredoc would
# occupy stdin, clobbering the JSON the caller redirects in.
json_get_str() {
    local path="$1"
    python3 -c '
import json, sys
path = sys.argv[1].split(".")
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
cur = data
for part in path:
    if isinstance(cur, list):
        try: idx = int(part)
        except ValueError: sys.exit(0)
        if idx < 0 or idx >= len(cur): sys.exit(0)
        cur = cur[idx]
    elif isinstance(cur, dict):
        if part not in cur: sys.exit(0)
        cur = cur[part]
    else: sys.exit(0)
if cur is None: sys.exit(0)
if isinstance(cur, (dict, list)): print(json.dumps(cur))
else: print(cur)
' "$path" 2>/dev/null || true
}

# Pick most-recent company from GET /api/companies and print "<id>\t<shortCode>\t<name>".
json_pick_latest_company() {
    python3 -c '
import json, sys
try: data = json.load(sys.stdin)
except Exception: sys.exit(0)
items = None
if isinstance(data, list): items = data
elif isinstance(data, dict):
    for k in ("companies", "data", "items", "results"):
        if k in data and isinstance(data[k], list):
            items = data[k]; break
if not items: sys.exit(0)
def created_key(it):
    if not isinstance(it, dict): return ""
    for k in ("createdAt", "created_at", "created", "insertedAt"):
        v = it.get(k)
        if v: return str(v)
    return ""
items_sorted = sorted(items, key=created_key)
latest = items_sorted[-1] if items_sorted else None
if not isinstance(latest, dict): sys.exit(0)
cid = latest.get("id") or latest.get("companyId") or ""
short = (latest.get("shortCode") or latest.get("short_code")
         or latest.get("slug") or latest.get("handle") or "")
name = latest.get("name") or ""
print(f"{cid}\t{short}\t{name}")
' 2>/dev/null || true
}

json_escape_str() {
    python3 - "$1" <<'PY'
import json, sys
print(json.dumps(sys.argv[1]))
PY
}

# Convert a YAML file to JSON via js-yaml from paperclip's pnpm store.
# js-yaml is only a transitive dep of paperclip, so it never lands at
# paperclip/node_modules/js-yaml — resolve it inside the .pnpm store instead.
yaml_to_json() {
    local yaml_path="$1"
    local jsyaml_dir
    jsyaml_dir=$(ls -d "$REPO_ROOT"/paperclip/node_modules/.pnpm/js-yaml@*/node_modules/js-yaml 2>/dev/null | head -1)
    if [[ -z "$jsyaml_dir" ]]; then
        err "js-yaml not found in paperclip's dependency store. Run: pnpm -C paperclip install"
        return 1
    fi
    pnpm -C "$REPO_ROOT/paperclip" exec node -e "
        const yaml = require(process.argv[2]);
        const fs = require('fs');
        process.stdout.write(JSON.stringify(yaml.load(fs.readFileSync(process.argv[1], 'utf8'))));
    " "$yaml_path" "$jsyaml_dir"
}

# ---------------------------------------------------------------------------
# Flag parsing
# ---------------------------------------------------------------------------

VARIANT=""
MISSION=""
ORG_NAME="$PACKAGE_DEFAULT_ORG_NAME"
DATA_DIR="$DEFAULT_DATA_DIR"
PORT="$DEFAULT_PORT"
GATE_PORT="$DEFAULT_GATE_PORT"
NO_GATE_PROXY="false"
PACKAGE="$DEFAULT_PACKAGE"
VARIANTS_FILE="$DEFAULT_VARIANTS_FILE"
PAPERCLIP_YAML=""
RESET="false"
ASSUME_YES="false"
NON_INTERACTIVE="false"
DRY_RUN="false"
LIST_VARIANTS_ONLY="false"
NO_BROWSER="false"
SKIP_MODEL_PROBE="false"
THEME="${POSSIBLAW_THEME:-possiblaw}"
ONBOARD_EXTRA_ENV=""
DEMO_PROFILE=""
TEAMS=""
BUSINESS_SLUG=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        --variant) [ "$#" -ge 2 ] || { err "--variant requires a value"; exit 2; }; VARIANT="$2"; shift 2 ;;
        --mission) [ "$#" -ge 2 ] || { err "--mission requires a value"; exit 2; }; MISSION="$2"; shift 2 ;;
        --org-name) [ "$#" -ge 2 ] || { err "--org-name requires a value"; exit 2; }; ORG_NAME="$2"; shift 2 ;;
        --data-dir) [ "$#" -ge 2 ] || { err "--data-dir requires a value"; exit 2; }; DATA_DIR="$2"; shift 2 ;;
        --port) [ "$#" -ge 2 ] || { err "--port requires a value"; exit 2; }; PORT="$2"; shift 2 ;;
        --gate-port) [ "$#" -ge 2 ] || { err "--gate-port requires a value"; exit 2; }; GATE_PORT="$2"; shift 2 ;;
        --no-gate-proxy) NO_GATE_PROXY="true"; shift ;;
        --package) [ "$#" -ge 2 ] || { err "--package requires a value"; exit 2; }; PACKAGE="$2"; shift 2 ;;
        --variants-file) [ "$#" -ge 2 ] || { err "--variants-file requires a value"; exit 2; }; VARIANTS_FILE="$2"; shift 2 ;;
        --reset) RESET="true"; shift ;;
        --yes) ASSUME_YES="true"; shift ;;
        --non-interactive) NON_INTERACTIVE="true"; shift ;;
        --dry-run) DRY_RUN="true"; shift ;;
        --list-variants) LIST_VARIANTS_ONLY="true"; shift ;;
        --skip-model-probe) SKIP_MODEL_PROBE="true"; shift ;;
        --theme) [ "$#" -ge 2 ] || { err "--theme requires a value"; exit 2; }; THEME="$2"; shift 2 ;;
        --demo) [ "$#" -ge 2 ] || { err "--demo requires a value"; exit 2; }; DEMO_PROFILE="$2"; shift 2 ;;
        --teams) [ "$#" -ge 2 ] || { err "--teams requires a value"; exit 2; }; TEAMS="$2"; shift 2 ;;
        --business) [ "$#" -ge 2 ] || { err "--business requires a value"; exit 2; }; BUSINESS_SLUG="$2"; shift 2 ;;
        --no-browser) NO_BROWSER="true"; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        *) err "Unknown argument: $1"; usage >&2; exit 2 ;;
    esac
done

# Normalize relative paths against CWD (so the script can be invoked from anywhere).
for var in DATA_DIR PACKAGE VARIANTS_FILE; do
    val="${!var}"
    case "$val" in
        /*) : ;;
        *) printf -v "$var" '%s' "$(pwd)/$val" ;;
    esac
done

# If --package was overridden but --variants-file wasn't, recompute its default.
if [ "$VARIANTS_FILE" = "$DEFAULT_VARIANTS_FILE" ] && [ "$PACKAGE" != "$DEFAULT_PACKAGE" ]; then
    VARIANTS_FILE="$PACKAGE/variants.yaml"
fi
PAPERCLIP_YAML="$PACKAGE/.paperclip.yaml"

# ---------------------------------------------------------------------------
# --business: resolve firm identity dir and firm-memory file
# ---------------------------------------------------------------------------
#
# When --business <slug> is given:
#   1. Resolve businesses/<slug>/ under REPO_ROOT.
#   2. If the directory does not exist, copy businesses/_template/ to it.
#   3. Set BUSINESS_DIR and FIRM_MEMORY_FILE for later use in the bundle step
#      and the per-agent env PATCH.

BUSINESS_DIR=""
FIRM_MEMORY_FILE=""
if [ -n "$BUSINESS_SLUG" ]; then
    # Slug containment guard: reject path-traversal characters before building
    # any filesystem path. Only [A-Za-z0-9._-] is allowed; this rejects '/'
    # and '..' and any other shell-special characters.
    if ! printf '%s' "$BUSINESS_SLUG" | grep -qE '^[A-Za-z0-9._-]+$'; then
        err "--business slug contains invalid characters: '$BUSINESS_SLUG'"
        err "Allowed: letters, digits, '.', '_', '-' (no slashes or path traversal)"
        exit 1
    fi
    BUSINESS_DIR="$REPO_ROOT/businesses/$BUSINESS_SLUG"
    BUSINESSES_TEMPLATE="$REPO_ROOT/businesses/_template"
    if [ ! -d "$BUSINESS_DIR" ]; then
        if [ ! -d "$BUSINESSES_TEMPLATE" ]; then
            err "--business: template directory not found: $BUSINESSES_TEMPLATE"
            exit 1
        fi
        log "--business: creating $BUSINESS_DIR from template"
        cp -r "$BUSINESSES_TEMPLATE" "$BUSINESS_DIR"
    fi
    FIRM_MEMORY_FILE="$BUSINESS_DIR/memory/firm-memory.md"
    if [ ! -f "$FIRM_MEMORY_FILE" ]; then
        # Silently allow a missing file (fresh firm has no memory yet).
        FIRM_MEMORY_FILE=""
        log "--business: no firm-memory.md found at $BUSINESS_DIR/memory/; skipping overlay"
    else
        log "--business: will overlay firm memory from $FIRM_MEMORY_FILE"
    fi
fi

# ---------------------------------------------------------------------------
# --list-variants short-circuit
# ---------------------------------------------------------------------------

if [ "$LIST_VARIANTS_ONLY" = "true" ]; then
    if [ ! -f "$VARIANTS_FILE" ]; then
        err "variants file not found: $VARIANTS_FILE"
        exit 1
    fi
    if ! command -v pnpm >/dev/null 2>&1; then
        err "pnpm is required to read variants.yaml"
        exit 1
    fi
    LV_TMP="$(mktemp -t possiblaw-listvariants.XXXXXX.json)"
    yaml_to_json "$VARIANTS_FILE" > "$LV_TMP"
    python3 - "$LV_TMP" <<'PY'
import json, sys
doc = json.load(open(sys.argv[1]))
variants = doc.get("variants") or {}
for slug, v in variants.items():
    label = v.get("label") or slug
    reqs = []
    if v.get("requires_cli"): reqs.append(f"cli: {v['requires_cli']}")
    if v.get("requires_ollama"): reqs.append("ollama")
    if v.get("requires_endpoint"):
        reqs.append(f"endpoint: {v['requires_endpoint']}")
    if v.get("requires_opencode_provider"):
        reqs.append(f"opencode-provider: {v['requires_opencode_provider']}")
    for env_key in (v.get("secret_env") or {}):
        reqs.append(f"env: {env_key}")
    if v.get("local"): reqs.append("fully local")
    suffix = f"  [{', '.join(reqs)}]" if reqs else ""
    print(f"  {slug:10s}  {label}{suffix}")
PY
    rm -f "$LV_TMP"
    exit 0
fi

# ---------------------------------------------------------------------------
# Header
# ---------------------------------------------------------------------------

log "PossibLaw launcher starting"
log "repo root:     $REPO_ROOT"
log "data dir:      $DATA_DIR"
log "port:          $PORT"
log "package:       $PACKAGE"
log "variants file: $VARIANTS_FILE"
log "dry run:       $DRY_RUN"
if [ "$NO_GATE_PROXY" = "true" ]; then
    log "gate proxy:    disabled (--no-gate-proxy, demo-only)"
else
    log "gate proxy:    port $GATE_PORT (live runs only)"
fi
log ""
log "Pre-flight checks:"

PREFLIGHT_FAILED="false"

require_cmd pnpm "https://pnpm.io/installation (e.g. 'npm install -g pnpm@9.15.4')" || PREFLIGHT_FAILED="true"
require_cmd curl "install curl via your package manager" || PREFLIGHT_FAILED="true"
require_cmd python3 "install Python 3 via your package manager or Homebrew" || PREFLIGHT_FAILED="true"

PAPERCLIP_DIR="$REPO_ROOT/paperclip"
if [ ! -d "$PAPERCLIP_DIR" ]; then
    err "Paperclip submodule not found at: $PAPERCLIP_DIR"
    err "Run: git submodule update --init --recursive"
    PREFLIGHT_FAILED="true"
else
    log "ok: paperclip submodule found at $PAPERCLIP_DIR"
fi

for p in "$PACKAGE" "$VARIANTS_FILE" "$PAPERCLIP_YAML" "$VARIANTS_PY" "$INLINE_PY"; do
    if [ ! -e "$p" ]; then
        err "missing required file: $p"
        PREFLIGHT_FAILED="true"
    fi
done

DATA_DIR_PARENT="$(dirname "$DATA_DIR")"
if [ ! -d "$DATA_DIR_PARENT" ]; then
    log "data dir parent does not exist; will create: $DATA_DIR_PARENT"
    mkdir -p "$DATA_DIR_PARENT" || { err "Could not create $DATA_DIR_PARENT"; PREFLIGHT_FAILED="true"; }
fi
if [ -d "$DATA_DIR_PARENT" ] && [ ! -w "$DATA_DIR_PARENT" ]; then
    err "Data dir parent is not writable: $DATA_DIR_PARENT"
    PREFLIGHT_FAILED="true"
fi

if [ "$PREFLIGHT_FAILED" = "true" ]; then
    err "Pre-flight failed."
    exit 1
fi

milestone "pre-flight complete"

# ---------------------------------------------------------------------------
# --teams: expand presets and validate every name against the package's lead
# roster BEFORE any probe, data-dir write, or server start. Unknown -> exit 1.
# ---------------------------------------------------------------------------

TEAMS_PRESET_BOUTIQUE="commercial,employment,litigation,real-estate,family-law,estates,bd,ops,finance,marketing,admin,legal-ops"
TEAMS_PRESET_INHOUSE="commercial,employment,privacy,corporate,regulatory,ai-governance,legal-ops,bd,ops,finance,marketing,admin"
if [ -n "$TEAMS" ]; then
    case "$TEAMS" in
        boutique) TEAMS="$TEAMS_PRESET_BOUTIQUE"; log "teams: preset 'boutique' -> $TEAMS" ;;
        inhouse)  TEAMS="$TEAMS_PRESET_INHOUSE"; log "teams: preset 'inhouse' -> $TEAMS" ;;
    esac
    VALID_TEAMS="$(python3 "$INLINE_PY" --package-root "$PACKAGE" --list-teams)" || {
        err "could not read the team roster from $PACKAGE"
        exit 1
    }
    INVALID_TEAMS=""
    OLD_IFS="$IFS"; IFS=','
    for team in $TEAMS; do
        team="$(printf '%s' "$team" | tr -d '[:space:]')"
        [ -n "$team" ] || continue
        if ! printf '%s\n' "$VALID_TEAMS" | grep -qx "$team"; then
            INVALID_TEAMS="$INVALID_TEAMS $team"
        fi
    done
    IFS="$OLD_IFS"
    if [ -n "$INVALID_TEAMS" ]; then
        err "Unknown team(s):$INVALID_TEAMS"
        err "Valid teams (lead slugs without -lead), or presets boutique|inhouse:"
        printf '%s\n' "$VALID_TEAMS" | while IFS= read -r t; do err "  - $t"; done
        exit 1
    fi
    log "teams: subset import enabled ($TEAMS)"
fi

# ---------------------------------------------------------------------------
# Variant selection
# ---------------------------------------------------------------------------

# Load variants doc as JSON once.
VARIANTS_JSON_FILE="$(mktemp -t possiblaw-variants.XXXXXX.json)"
yaml_to_json "$VARIANTS_FILE" > "$VARIANTS_JSON_FILE"

list_variant_slugs() {
    python3 - "$VARIANTS_JSON_FILE" <<'PY'
import json, sys
with open(sys.argv[1]) as fh:
    doc = json.load(fh)
for slug in (doc.get("variants") or {}).keys():
    print(slug)
PY
}

variant_label() {
    python3 - "$VARIANTS_JSON_FILE" "$1" <<'PY'
import json, sys
with open(sys.argv[1]) as fh:
    doc = json.load(fh)
v = (doc.get("variants") or {}).get(sys.argv[2]) or {}
print(v.get("label") or sys.argv[2])
PY
}

variant_field() {
    # variant_field <variant-slug> <field-name>
    python3 - "$VARIANTS_JSON_FILE" "$1" "$2" <<'PY'
import json, sys
with open(sys.argv[1]) as fh:
    doc = json.load(fh)
v = (doc.get("variants") or {}).get(sys.argv[2]) or {}
val = v.get(sys.argv[3])
if val is None: sys.exit(0)
if isinstance(val, bool): print("true" if val else "false")
else: print(val)
PY
}

if [ -z "$VARIANT" ]; then
    if [ "$NON_INTERACTIVE" = "true" ]; then
        err "--non-interactive requires --variant"
        exit 2
    fi
    echo
    echo "Choose a model provider variant:"
    SLUGS=()
    while IFS= read -r slug; do SLUGS+=("$slug"); done < <(list_variant_slugs)
    if [ "${#SLUGS[@]}" -eq 0 ]; then
        err "No variants defined in $VARIANTS_FILE"
        exit 1
    fi
    idx=1
    for slug in "${SLUGS[@]}"; do
        label="$(variant_label "$slug")"
        printf '  [%d] %s — %s\n' "$idx" "$slug" "$label"
        idx=$((idx + 1))
    done
    printf 'Variant [1-%d]: ' "${#SLUGS[@]}"
    if ! read -r choice; then err "no input"; exit 1; fi
    case "$choice" in ''|*[!0-9]*) err "invalid choice"; exit 2 ;; esac
    if [ "$choice" -lt 1 ] || [ "$choice" -gt "${#SLUGS[@]}" ]; then
        err "out of range"; exit 2
    fi
    VARIANT="${SLUGS[$((choice - 1))]}"
fi

# Validate the variant exists.
if ! list_variant_slugs | grep -qx "$VARIANT"; then
    err "Unknown variant: $VARIANT"
    err "Available: $(list_variant_slugs | tr '\n' ' ')"
    exit 2
fi
milestone "variant: $VARIANT ($(variant_label "$VARIANT"))"

# Per-variant CLI preflight. Dry-run never invokes the variant CLI (the
# preview is server-side), so a missing CLI only warns there — same pattern
# as the secret_env dry-run behavior below.
REQUIRES_CLI="$(variant_field "$VARIANT" requires_cli)"
if [ -n "$REQUIRES_CLI" ]; then
    if ! require_cmd "$REQUIRES_CLI" "the '$VARIANT' variant requires the '$REQUIRES_CLI' CLI"; then
        if [ "$DRY_RUN" = "true" ]; then
            warn "dry-run continues without the '$REQUIRES_CLI' CLI, but a live run requires it."
        else
            exit 1
        fi
    fi
fi

# ---------------------------------------------------------------------------
# Dual-auth preflight
# ---------------------------------------------------------------------------
#
# API-key variants declare secret_env in variants.yaml (ENV_KEY -> display
# name). The key must be exported in this shell; after a live import it is
# stored ONCE as a paperclip company secret and bound to every agent via a
# secret_ref env binding. It never lands in package files or the import body.

SECRET_ENV_TSV="$(python3 "$VARIANTS_PY" --variants-json "$VARIANTS_JSON_FILE" --variant "$VARIANT" --show-secret-env || true)"
if [ -n "$SECRET_ENV_TSV" ]; then
    while IFS=$'\t' read -r env_key env_name; do
        [ -n "$env_key" ] || continue
        if [ -z "${!env_key:-}" ]; then
            if [ "$DRY_RUN" = "true" ]; then
                warn "$env_key is not set. Dry-run continues (no secret is created),"
                warn "but a live run of '$VARIANT' requires: export $env_key=..."
            else
                err "The '$VARIANT' variant requires \$$env_key ($env_name) in this shell."
                err "Either: export $env_key=...   then re-run,"
                case "$VARIANT" in
                    *-api) err "or use the subscription variant instead (--variant ${VARIANT%-api})." ;;
                    *)     err "or pick a variant that doesn't need it (see --list-variants)." ;;
                esac
                exit 1
            fi
        else
            log "ok: \$$env_key is set ($env_name; stored as a company secret after import)"
        fi
    done <<< "$SECRET_ENV_TSV"
else
    # Subscription variants: warn if an API key in this shell would silently
    # flip the CLI to API billing (the paperclip server inherits this env).
    case "$REQUIRES_CLI" in
        claude)
            if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
                warn "ANTHROPIC_API_KEY is set in this shell. The claude CLI will bill your"
                warn "API account instead of the subscription. Unset it before running, or"
                warn "switch to '--variant claude-api' to make API billing explicit."
            fi
            ;;
        codex)
            if [ -n "${OPENAI_API_KEY:-}" ]; then
                warn "OPENAI_API_KEY is set in this shell. The codex CLI will bill your"
                warn "API account instead of the subscription. Unset it before running, or"
                warn "switch to '--variant codex-api' to make API billing explicit."
            fi
            ;;
        gemini)
            if [ -n "${GEMINI_API_KEY:-}" ] || [ -n "${GOOGLE_API_KEY:-}" ]; then
                warn "GEMINI_API_KEY/GOOGLE_API_KEY is set in this shell. The gemini CLI will"
                warn "bill your API account instead of the subscription. Unset it before"
                warn "running, or switch to '--variant gemini-api' to make API billing explicit."
            fi
            ;;
    esac
fi

# Local-runtime preflight: ollama daemon / generic endpoint + OpenCode config.
# Reachability blocks live runs and warns on dry-run (preview is server-side).
REQUIRES_OLLAMA="$(variant_field "$VARIANT" requires_ollama)"
REQUIRES_ENDPOINT="$(variant_field "$VARIANT" requires_endpoint)"
ENDPOINT_HINT="$(variant_field "$VARIANT" endpoint_hint)"
REQUIRES_OPENCODE_PROVIDER="$(variant_field "$VARIANT" requires_opencode_provider)"
if [ "$REQUIRES_OLLAMA" = "true" ]; then
    OLLAMA_VERSION_HTTP="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 3 http://localhost:11434/api/version || true)"
    if [ "$OLLAMA_VERSION_HTTP" != "200" ]; then
        if [ "$DRY_RUN" = "true" ]; then
            warn "Ollama daemon not reachable at http://localhost:11434 (HTTP $OLLAMA_VERSION_HTTP)."
            warn "Dry-run continues, but a live '$VARIANT' run requires it."
        else
            err "Ollama daemon not reachable at http://localhost:11434/api/version (HTTP $OLLAMA_VERSION_HTTP)."
            err "Install: https://ollama.com — then 'ollama serve' and 'ollama pull llama3.1:8b'."
            exit 1
        fi
    else
        log "ok: Ollama daemon reachable"
    fi
fi
if [ -n "$REQUIRES_ENDPOINT" ]; then
    ENDPOINT_HTTP="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 3 "$REQUIRES_ENDPOINT" || true)"
    if [ "$ENDPOINT_HTTP" != "200" ]; then
        if [ "$DRY_RUN" = "true" ]; then
            warn "endpoint not reachable: $REQUIRES_ENDPOINT (HTTP $ENDPOINT_HTTP)."
            warn "Dry-run continues, but a live '$VARIANT' run requires it."
            [ -n "$ENDPOINT_HINT" ] && warn "hint: $ENDPOINT_HINT"
        else
            err "The '$VARIANT' variant needs a local server, but $REQUIRES_ENDPOINT is not reachable (HTTP $ENDPOINT_HTTP)."
            [ -n "$ENDPOINT_HINT" ] && err "hint: $ENDPOINT_HINT"
            exit 1
        fi
    else
        log "ok: endpoint reachable: $REQUIRES_ENDPOINT"
    fi
fi
# Starter opencode.json provider block per provider name. Empty output means
# no template exists and the operator must write the block manually.
opencode_provider_template() {
    case "$1" in
        ollama) cat <<'JSON'
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "llama3.1:8b":  { "name": "Llama 3.1 8B" },
        "llama3.1:70b": { "name": "Llama 3.1 70B" }
      }
    }
  }
}
JSON
            ;;
        llamacpp) cat <<'JSON'
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local llama-server)",
      "options": { "baseURL": "http://127.0.0.1:8080/v1" },
      "models": {
        "default": { "name": "llama-server loaded model" }
      }
    }
  }
}
JSON
            ;;
    esac
}

if [ -n "$REQUIRES_OPENCODE_PROVIDER" ]; then
    OPENCODE_CONFIG="$HOME/.config/opencode/opencode.json"
    if [ ! -f "$OPENCODE_CONFIG" ]; then
        if [ "$DRY_RUN" = "true" ]; then
            warn "OpenCode global config missing: $OPENCODE_CONFIG"
            warn "Dry-run continues, but a live '$VARIANT' run needs provider.$REQUIRES_OPENCODE_PROVIDER declared there."
        else
            err "OpenCode global config missing: $OPENCODE_CONFIG"
            err "The '$VARIANT' variant needs the '$REQUIRES_OPENCODE_PROVIDER' provider declared there."
            TEMPLATE="$(opencode_provider_template "$REQUIRES_OPENCODE_PROVIDER")"
            if [ -z "$TEMPLATE" ]; then
                err "No starter template for provider '$REQUIRES_OPENCODE_PROVIDER' — create it manually (see https://opencode.ai/docs/providers)."
                exit 1
            elif [ "$NON_INTERACTIVE" = "true" ] || [ "$ASSUME_YES" = "true" ]; then
                err "Re-run interactively to let the launcher write a starter config, or create it manually."
                exit 1
            elif confirm "Write a minimal $OPENCODE_CONFIG with provider.$REQUIRES_OPENCODE_PROVIDER?"; then
                mkdir -p "$(dirname "$OPENCODE_CONFIG")"
                printf '%s\n' "$TEMPLATE" > "$OPENCODE_CONFIG"
                log "wrote $OPENCODE_CONFIG"
            else
                exit 1
            fi
        fi
    else
        HAS_PROVIDER="$(python3 - "$OPENCODE_CONFIG" "$REQUIRES_OPENCODE_PROVIDER" <<'PY' 2>/dev/null || echo no
import json, sys
try:
    doc = json.load(open(sys.argv[1]))
except Exception:
    print("no"); sys.exit(0)
prov = (doc.get("provider") or {})
print("yes" if sys.argv[2] in prov else "no")
PY
)"
        if [ "$HAS_PROVIDER" != "yes" ]; then
            if [ "$DRY_RUN" = "true" ]; then
                warn "$OPENCODE_CONFIG exists but does not declare provider.$REQUIRES_OPENCODE_PROVIDER"
                warn "Dry-run continues, but a live '$VARIANT' run requires it (see https://opencode.ai/docs/providers)."
            else
                err "$OPENCODE_CONFIG exists but does not declare provider.$REQUIRES_OPENCODE_PROVIDER"
                err "Add it manually (see https://opencode.ai/docs/providers)."
                exit 1
            fi
        else
            log "ok: OpenCode global config declares provider.$REQUIRES_OPENCODE_PROVIDER"
        fi
    fi
fi

# ---------------------------------------------------------------------------
# Preflight model probe (codex/claude variants, live runs only)
# ---------------------------------------------------------------------------
#
# The paperclip adapters ship hardcoded model catalogs, but the real access
# check happens inside the CLI at run time — a model your plan doesn't include
# fails mid-run with "you don't have access". Probe each distinct lane model
# with a tiny request now so that error surfaces before anything is imported.
# Skip with --skip-model-probe. Each probe is one minimal CLI call.

MODEL_PROBE_TIMEOUT_SECS=120

probe_model() {
    # probe_model <cli> <model> → 0 on success; failure detail on stderr
    local cli="$1" model="$2" rc=0
    local out_file err_file
    out_file="$(mktemp -t possiblaw-probe-out.XXXXXX)"
    err_file="$(mktemp -t possiblaw-probe-err.XXXXXX)"
    # stdin must be /dev/null: codex exec reads stdin when it isn't a TTY,
    # and an interactive TTY would make probe behavior terminal-dependent.
    case "$cli" in
        claude)
            ( cd "$REPO_ROOT" && claude -p "Reply with exactly: OK" \
                --model "$model" --output-format text ) \
                > "$out_file" 2> "$err_file" </dev/null &
            ;;
        codex)
            # Force low reasoning effort: probes should be cheap/fast even if
            # the operator's codex config defaults to xhigh.
            ( cd "$REPO_ROOT" && codex exec -s read-only -m "$model" \
                -c model_reasoning_effort=low \
                "Reply with exactly: OK" ) \
                > "$out_file" 2> "$err_file" </dev/null &
            ;;
        gemini)
            ( cd "$REPO_ROOT" && gemini -m "$model" \
                -p "Reply with exactly: OK" ) \
                > "$out_file" 2> "$err_file" </dev/null &
            ;;
        *)
            rm -f "$out_file" "$err_file"
            return 0
            ;;
    esac
    local probe_pid=$!
    ( sleep "$MODEL_PROBE_TIMEOUT_SECS"; kill "$probe_pid" 2>/dev/null ) &
    local watchdog_pid=$!
    if wait "$probe_pid"; then rc=0; else rc=$?; fi
    kill "$watchdog_pid" 2>/dev/null || true
    wait "$watchdog_pid" 2>/dev/null || true
    if [ "$rc" -ne 0 ] || [ ! -s "$out_file" ]; then
        err "model probe failed for '$model' (exit $rc)"
        # claude prints model-access errors to stdout; codex to stderr.
        if [ -s "$err_file" ]; then
            head -3 "$err_file" | sed 's/^/  /' >&2
        elif [ -s "$out_file" ]; then
            head -3 "$out_file" | sed 's/^/  /' >&2
        fi
        rm -f "$out_file" "$err_file"
        return 1
    fi
    rm -f "$out_file" "$err_file"
    return 0
}

if [ "$DRY_RUN" != "true" ] && [ "$SKIP_MODEL_PROBE" != "true" ] \
        && { [ "$REQUIRES_CLI" = "claude" ] || [ "$REQUIRES_CLI" = "codex" ] \
             || [ "$REQUIRES_CLI" = "gemini" ]; }; then
    PROBE_PAPERCLIP_JSON="$(mktemp -t possiblaw-probe-paperclip.XXXXXX.json)"
    yaml_to_json "$PAPERCLIP_YAML" > "$PROBE_PAPERCLIP_JSON"
    PROBE_MODELS="$(python3 "$VARIANTS_PY" \
        --variants-json "$VARIANTS_JSON_FILE" \
        --paperclip-json "$PROBE_PAPERCLIP_JSON" \
        --variant "$VARIANT" --list-models 2>/dev/null || true)"
    rm -f "$PROBE_PAPERCLIP_JSON"
    if [ -n "$PROBE_MODELS" ]; then
        PROBE_FAILED=""
        while IFS= read -r probe_model_id; do
            [ -n "$probe_model_id" ] || continue
            log "probing $REQUIRES_CLI model '$probe_model_id' (timeout ${MODEL_PROBE_TIMEOUT_SECS}s)..."
            if probe_model "$REQUIRES_CLI" "$probe_model_id"; then
                log "ok: model '$probe_model_id' responds"
            else
                PROBE_FAILED="$PROBE_FAILED $probe_model_id"
            fi
        done <<< "$PROBE_MODELS"
        if [ -n "$PROBE_FAILED" ]; then
            err "These models failed the preflight probe:$PROBE_FAILED"
            err "Likely causes: your plan/tier doesn't include them, or the CLI login expired."
            err "Options:"
            case "$VARIANT" in
                *-api)
                    err "  1. Verify the API key is valid and has access to these models." ;;
                *)
                    err "  1. Use the API-key twin variant (--variant ${VARIANT}-api) — API auth"
                    err "     usually unlocks the full catalog." ;;
            esac
            err "  2. Edit the lane models in $VARIANTS_FILE to ones your plan includes."
            err "  3. Re-run with --skip-model-probe to proceed anyway (runs may fail mid-issue)."
            exit 1
        fi
    fi
fi

# ---------------------------------------------------------------------------
# OpenRouter catalog pin check (opencode variants, live runs only)
# ---------------------------------------------------------------------------
#
# The probe above only covers the claude/codex CLIs. For variants riding
# OpenCode's native openrouter provider, verify each pinned model id still
# exists in the public catalog (one keyless GET — no token spend). Model pins
# rot as vendors rotate catalogs; surface that at launch, not mid-matter.

if [ "$DRY_RUN" != "true" ] && [ "$SKIP_MODEL_PROBE" != "true" ] && [ "$REQUIRES_CLI" = "opencode" ]; then
    ORC_PAPERCLIP_JSON="$(mktemp -t possiblaw-orc-paperclip.XXXXXX.json)"
    yaml_to_json "$PAPERCLIP_YAML" > "$ORC_PAPERCLIP_JSON"
    ORC_MODELS="$(python3 "$VARIANTS_PY" \
        --variants-json "$VARIANTS_JSON_FILE" \
        --paperclip-json "$ORC_PAPERCLIP_JSON" \
        --variant "$VARIANT" --list-models 2>/dev/null | { grep '^openrouter/' || true; })"
    rm -f "$ORC_PAPERCLIP_JSON"
    if [ -n "$ORC_MODELS" ]; then
        ORC_CATALOG="$(mktemp -t possiblaw-orc-catalog.XXXXXX.json)"
        if curl --silent --fail --max-time 15 https://openrouter.ai/api/v1/models -o "$ORC_CATALOG"; then
            ORC_FAILED=""
            while IFS= read -r orc_model; do
                [ -n "$orc_model" ] || continue
                orc_id="${orc_model#openrouter/}"
                if python3 -c '
import json, sys
ids = {m.get("id") for m in (json.load(open(sys.argv[1])).get("data") or [])}
sys.exit(0 if sys.argv[2] in ids else 1)
' "$ORC_CATALOG" "$orc_id"; then
                    log "ok: openrouter catalog lists '$orc_id'"
                else
                    ORC_FAILED="$ORC_FAILED $orc_model"
                fi
            done <<< "$ORC_MODELS"
            if [ -n "$ORC_FAILED" ]; then
                err "These pinned models are missing from the OpenRouter catalog:$ORC_FAILED"
                err "Edit the lane models in $VARIANTS_FILE (see https://openrouter.ai/models),"
                err "or re-run with --skip-model-probe to proceed anyway."
                rm -f "$ORC_CATALOG"
                exit 1
            fi
        else
            warn "could not fetch the OpenRouter catalog (offline?) — skipping the model pin check"
        fi
        rm -f "$ORC_CATALOG"
    fi
fi

# ---------------------------------------------------------------------------
# Privacy-lane preflight scan (non-blocking warning)
# ---------------------------------------------------------------------------
#
# If the package ships any matter declaring metadata.possiblaw.privacyTier =
# confidential|privileged, the privacy-encoder skill will require a local
# model lane at runtime (see skills/privacy-encoder/SKILL.md §0). Warn now so
# the operator can start one before a confidential matter blocks. Non-blocking
# — the operator may not run any confidential matter this session. Variants
# flagged `local: true` in variants.yaml (ollama, llamacpp) already ARE the
# local lane, so the warning is skipped for them.
#
IS_LOCAL_VARIANT="$(variant_field "$VARIANT" local)"
CONFIDENTIAL_HITS=0
if [ -d "$PACKAGE/projects" ]; then
    CONFIDENTIAL_HITS="$(
        { grep -rlE 'privacyTier:[[:space:]]*(confidential|privileged)' "$PACKAGE/projects" 2>/dev/null || true; } \
            | wc -l | tr -d ' '
    )"
fi
if [ "$CONFIDENTIAL_HITS" -gt 0 ] && [ "$IS_LOCAL_VARIANT" != "true" ]; then
    OLLAMA_PRESENT_HTTP="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 2 http://localhost:11434/api/version 2>/dev/null || echo 000)"
    if [ "$OLLAMA_PRESENT_HTTP" != "200" ]; then
        warn "package contains $CONFIDENTIAL_HITS matter(s) with privacyTier confidential/privileged"
        warn "Ollama not reachable at http://localhost:11434 — confidential matters will BLOCK at runtime"
        warn "to fix: install Ollama (https://ollama.com), then 'ollama serve' + 'ollama pull llama3.1:8b'"
    fi
fi

# ---------------------------------------------------------------------------
# Mission prompt
# ---------------------------------------------------------------------------

if [ -z "$MISSION" ]; then
    if [ "$NON_INTERACTIVE" = "true" ]; then
        err "--non-interactive requires --mission"
        exit 2
    fi
    echo
    echo "Mission (one line — what is this company for?):"
    printf '> '
    if ! IFS= read -r MISSION; then err "no input"; exit 1; fi
fi
MISSION="$(printf '%s' "$MISSION" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
if [ -z "$MISSION" ]; then
    err "Mission cannot be empty"
    exit 2
fi
milestone "mission captured (${#MISSION} chars)"

# ---------------------------------------------------------------------------
# Reset (optional)
# ---------------------------------------------------------------------------

if [ "$RESET" = "true" ] && [ -e "$DATA_DIR" ]; then
    if [ "$ASSUME_YES" != "true" ]; then
        if ! confirm "About to delete existing data dir: $DATA_DIR. Continue?"; then
            err "Reset cancelled."
            exit 1
        fi
    fi
    log "removing existing data dir: $DATA_DIR"
    rm -rf "$DATA_DIR"
fi
mkdir -p "$DATA_DIR"

LAUNCHER_LOG="$DATA_DIR/possiblaw.log"
LAUNCHER_PID_FILE="$DATA_DIR/possiblaw.pid"
GATE_PID_FILE="$DATA_DIR/gate-proxy.pid"
GATE_LOG="$DATA_DIR/gate-proxy.log"
GATE_PROXY_URL="http://127.0.0.1:$GATE_PORT"
GATE_RECEIPTS_PATH="$HOME/.possiblaw/gate-receipts/$(basename "$DATA_DIR")/receipts.jsonl"
: > "$LAUNCHER_LOG"

# ---------------------------------------------------------------------------
# Signal trap — stop background Paperclip on Ctrl-C until detach
# ---------------------------------------------------------------------------

PAPERCLIP_PID=""
GATE_PROXY_PID=""

kill_subshell_tree() {
    # Kill the subshell wrapper, all its descendants, and any process holding the given port.
    local subshell="$1"
    local port="$2"
    if [ -n "$subshell" ] && kill -0 "$subshell" 2>/dev/null; then
        # Cascade descendants first (pgrep -P only goes one level; recurse).
        local stack=("$subshell")
        local all=()
        while [ "${#stack[@]}" -gt 0 ]; do
            local current="${stack[0]}"
            stack=("${stack[@]:1}")
            all+=("$current")
            local children
            children="$(pgrep -P "$current" 2>/dev/null || true)"
            if [ -n "$children" ]; then
                # shellcheck disable=SC2206
                stack+=( $children )
            fi
        done
        # Kill from leaves up so children don't get re-parented.
        for ((i=${#all[@]}-1; i>=0; i--)); do
            kill "${all[$i]}" 2>/dev/null || true
        done
        sleep 2
        for ((i=${#all[@]}-1; i>=0; i--)); do
            kill -9 "${all[$i]}" 2>/dev/null || true
        done
    fi
    # Belt and suspenders: anything still on the port goes too.
    local port_pids
    port_pids="$(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null || true)"
    if [ -n "$port_pids" ]; then
        # shellcheck disable=SC2086
        kill $port_pids 2>/dev/null || true
        sleep 1
        # shellcheck disable=SC2086
        kill -9 $port_pids 2>/dev/null || true
    fi
}

kill_paperclip_tree() { kill_subshell_tree "$1" "$PORT"; }

kill_gate_proxy_tree() {
    # No-op until the gate proxy has started; mirrors possiblaw.pid handling.
    [ -n "$GATE_PROXY_PID" ] || return 0
    kill_subshell_tree "$GATE_PROXY_PID" "$GATE_PORT"
    [ -f "$GATE_PID_FILE" ] && rm -f "$GATE_PID_FILE"
    GATE_PROXY_PID=""
}

cleanup_on_signal() {
    local signal="$1"
    warn "received $signal; stopping Paperclip and the gate proxy"
    kill_gate_proxy_tree
    kill_paperclip_tree "$PAPERCLIP_PID"
    [ -f "$LAUNCHER_PID_FILE" ] && rm -f "$LAUNCHER_PID_FILE"
    exit 130
}
trap 'cleanup_on_signal SIGINT' INT
trap 'cleanup_on_signal SIGTERM' TERM

# ---------------------------------------------------------------------------
# UI theme overlay (light-first launch look, layer-not-fork)
# paperclip ships a complete light theme behind a localStorage toggle; the
# stock default is dark. For themes other than "dark" we serve a patched COPY
# of the built UI from paperclip/server/ui-dist (the server's first static
# lookup path) and force static mode. Only untracked files are created inside
# the submodule (same class as node_modules); --theme dark removes the overlay.
# Every failure path falls back to the stock vite-dev dark UI with a warning.
# ---------------------------------------------------------------------------

case "$THEME" in
    possiblaw|light|dark) : ;;
    *) err "Unknown --theme '$THEME' (expected: possiblaw, light, dark)"; exit 2 ;;
esac

DEMO_DIR=""
if [ -n "$DEMO_PROFILE" ]; then
    DEMO_DIR="$REPO_ROOT/companies/demos/$DEMO_PROFILE"
    if [ ! -d "$DEMO_DIR" ]; then
        err "Unknown demo profile: $DEMO_PROFILE"
        if [ -d "$REPO_ROOT/companies/demos" ]; then
            err "Available profiles:"
            for d in "$REPO_ROOT/companies/demos"/*/; do
                [ -d "$d" ] && err "  - $(basename "$d")"
            done
        fi
        exit 2
    fi
fi

apply_theme_overlay() {
    local ui_dist="$PAPERCLIP_DIR/ui/dist"
    local overlay="$PAPERCLIP_DIR/server/ui-dist"
    local marker="$overlay/.possiblaw-overlay"
    if [ "$THEME" = "dark" ]; then
        if [ -f "$marker" ]; then
            rm -rf "$overlay"
            log "theme: removed possiblaw UI overlay (stock dark theme restored)"
        fi
        return 0
    fi
    if [ -e "$overlay" ] && [ ! -f "$marker" ]; then
        warn "theme: $overlay exists but was not created by possiblaw; leaving it"
        warn "theme: alone and continuing with the stock UI."
        return 0
    fi
    if [ ! -f "$ui_dist/index.html" ]; then
        local build_log
        build_log="$(mktemp -t possiblaw-ui-build.XXXXXX.log)"
        log "theme: building the paperclip UI once (first themed run; ~1-2 min)..."
        if ! pnpm -C "$PAPERCLIP_DIR/ui" run build >"$build_log" 2>&1; then
            warn "theme: UI build failed (log: $build_log); continuing with the stock dark UI."
            return 0
        fi
        rm -f "$build_log"
    fi
    rm -rf "$overlay"
    mkdir -p "$overlay"
    if ! python3 "$THEME_PY" --patch-index --theme "$THEME" \
            --src "$ui_dist/index.html" --dest "$overlay/index.html"; then
        warn "theme: index.html patch failed; continuing with the stock dark UI."
        rm -rf "$overlay"
        return 0
    fi
    local entry base
    for entry in "$ui_dist"/*; do
        base="${entry##*/}"
        [ "$base" = "index.html" ] && continue
        ln -s "$entry" "$overlay/$base"
    done
    # Branded favicons: the stock index.html links and site.webmanifest all
    # reference these root files by name, so replacing the files swaps the
    # browser-tab icon to the PossibLaw tree with zero HTML changes.
    local branding_dir="$REPO_ROOT/branding/favicon"
    if [ -d "$branding_dir" ]; then
        for entry in "$branding_dir"/*; do
            base="${entry##*/}"
            rm -f "$overlay/$base"
            cp "$entry" "$overlay/$base"
        done
        log "theme: PossibLaw favicon set applied (browser tabs show the circuit tree)"
    fi
    : > "$marker"
    ONBOARD_EXTRA_ENV="PAPERCLIP_UI_DEV_MIDDLEWARE=false"
    log "theme: '$THEME' overlay ready (light-first; the in-app toggle still works and persists per browser)"
}

if [ "$DRY_RUN" = "true" ] && [ "$THEME" != "dark" ]; then
    log "theme: skipped on dry-run (applies to live launches)"
else
    # Runs for live launches and for --theme dark (cheap overlay removal).
    apply_theme_overlay
fi

# ---------------------------------------------------------------------------
# Onboard + run (background)
# In paperclipai 0.132+, `onboard --yes` implies `--run` and stays foreground.
# We launch it in the background and treat the subshell as our server handle.
# ---------------------------------------------------------------------------

milestone "running: paperclipai onboard --yes (background; runs the server inline)"
log "(log: $LAUNCHER_LOG)"
# Egress-credential scrub: adapter-spawned agents inherit the paperclip
# SERVER's process env (codex-local execute.ts merges process.env into the
# spawned CLI env), so any egress token here would reach every agent and let
# it bypass the gate proxy. Start the server with EGRESS_CRED_VARS unset;
# only the gate-proxy process gets them.
EGRESS_SCRUB_ARGS=()
for cred_var in $EGRESS_CRED_VARS; do
    EGRESS_SCRUB_ARGS+=(-u "$cred_var")
done
(
    cd "$PAPERCLIP_DIR"
    # onboard reads its port from $PORT (cli/src/commands/onboard.ts); without
    # this it requests 3100 regardless of --port and the health poll on
    # $API_BASE never succeeds when a custom port was chosen.
    # shellcheck disable=SC2086 — ONBOARD_EXTRA_ENV holds zero or more
    # space-free KEY=VALUE assignments (e.g. the static-UI mode flag).
    exec env "${EGRESS_SCRUB_ARGS[@]}" PORT="$PORT" $ONBOARD_EXTRA_ENV pnpm paperclipai onboard --data-dir "$DATA_DIR" --bind loopback --yes
) >>"$LAUNCHER_LOG" 2>&1 </dev/null &
PAPERCLIP_PID=$!
echo "$PAPERCLIP_PID" > "$LAUNCHER_PID_FILE"
log "paperclip subshell pid: $PAPERCLIP_PID (descendants own the server)"

API_BASE="http://127.0.0.1:$PORT"
HEALTH_URL="$API_BASE/api/health"
log "waiting for $HEALTH_URL (timeout ${HEALTH_TIMEOUT_SECS}s)"

WAITED=0
HEALTHY="false"
while [ "$WAITED" -lt "$HEALTH_TIMEOUT_SECS" ]; do
    if ! kill -0 "$PAPERCLIP_PID" 2>/dev/null; then
        err "paperclip server exited before becoming healthy"
        tail -n 80 "$LAUNCHER_LOG" >&2 || true
        rm -f "$LAUNCHER_PID_FILE"
        exit 1
    fi
    HTTP_CODE="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 3 "$HEALTH_URL" || true)"
    if [ "$HTTP_CODE" = "200" ]; then HEALTHY="true"; break; fi
    sleep "$HEALTH_POLL_INTERVAL_SECS"
    WAITED=$(( WAITED + HEALTH_POLL_INTERVAL_SECS ))
done
if [ "$HEALTHY" != "true" ]; then
    err "paperclip did not become healthy within ${HEALTH_TIMEOUT_SECS}s"
    tail -n 80 "$LAUNCHER_LOG" >&2 || true
    kill_paperclip_tree "$PAPERCLIP_PID"
    rm -f "$LAUNCHER_PID_FILE"
    exit 1
fi
milestone "paperclip healthy at $HEALTH_URL"

# Replace the subshell PID in $LAUNCHER_PID_FILE with the actual server PID
# (the process listening on $PORT) so `kill $(cat ...pid)` does the right thing.
SERVER_PID="$(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | head -n 1 || true)"
if [ -n "$SERVER_PID" ]; then
    echo "$SERVER_PID" > "$LAUNCHER_PID_FILE"
    log "paperclip server pid: $SERVER_PID (listening on $PORT)"
fi

# ---------------------------------------------------------------------------
# Detect pre-existing company on the server (non-reset re-runs)
# ---------------------------------------------------------------------------

EXISTING_COUNT="$(
    curl --silent --max-time 5 "$API_BASE/api/companies" 2>/dev/null \
        | python3 -c "
import json, sys
try: d=json.load(sys.stdin)
except: print(0); sys.exit(0)
items = d if isinstance(d, list) else (d.get('companies') or d.get('data') or d.get('items') or [])
print(len(items) if isinstance(items, list) else 0)
" 2>/dev/null \
        || echo 0
)"
if [ "$EXISTING_COUNT" -gt 0 ] && [ "$RESET" != "true" ]; then
    warn "Data dir already contains $EXISTING_COUNT company(ies). This run will add another."
    if [ "$ASSUME_YES" != "true" ] && [ "$NON_INTERACTIVE" != "true" ]; then
        if ! confirm "Continue importing alongside the existing company?"; then
            err "Cancelled. Re-run with --reset to wipe the data dir first."
            kill_paperclip_tree "$PAPERCLIP_PID"
            rm -f "$LAUNCHER_PID_FILE"
            exit 1
        fi
    fi
fi

# ---------------------------------------------------------------------------
# Build the import POST body
# ---------------------------------------------------------------------------

milestone "building import body (variant=$VARIANT, $(find "$PACKAGE" -type f | wc -l | tr -d ' ') files)"

DEMO_ARGS=()
if [ -n "$DEMO_DIR" ]; then
    DEMO_ARGS=(--extra-root "$DEMO_DIR")
    DEMO_PROJECT_COUNT="$(find "$DEMO_DIR" -name PROJECT.md | wc -l | tr -d ' ')"
    DEMO_TASK_COUNT="$(find "$DEMO_DIR" -name TASK.md | wc -l | tr -d ' ')"
    log "demo profile: $DEMO_PROFILE (+$DEMO_PROJECT_COUNT projects, +$DEMO_TASK_COUNT tasks; see $DEMO_DIR/README.md for the demo script)"
fi

TEAMS_ARGS=()
if [ -n "$TEAMS" ]; then
    TEAMS_ARGS=(--include-teams "$TEAMS")
fi

FIRM_MEMORY_ARGS=()
if [ -n "$FIRM_MEMORY_FILE" ]; then
    FIRM_MEMORY_ARGS=(--firm-memory-file "$FIRM_MEMORY_FILE")
fi

OVERLAY_ARGS=()
if [ -n "$BUSINESS_DIR" ]; then
    OVERLAY_ARGS=(--business-overlay-root "$BUSINESS_DIR")
fi

# Bundle BEFORE override generation: with --teams the bundle carries a
# filtered .paperclip.yaml, and adapter overrides must be generated from that
# filtered sidecar so no override references an agent outside the subset.
INLINE_FILE="$(mktemp -t possiblaw-inline.XXXXXX.json)"
if ! python3 "$INLINE_PY" --package-root "$PACKAGE" \
        ${DEMO_ARGS+"${DEMO_ARGS[@]}"} ${TEAMS_ARGS+"${TEAMS_ARGS[@]}"} \
        ${FIRM_MEMORY_ARGS+"${FIRM_MEMORY_ARGS[@]}"} ${OVERLAY_ARGS+"${OVERLAY_ARGS[@]}"} \
        > "$INLINE_FILE"; then
    err "inline source bundling failed"
    kill_paperclip_tree "$PAPERCLIP_PID"
    rm -f "$LAUNCHER_PID_FILE"
    exit 1
fi

PAPERCLIP_JSON_FILE="$(mktemp -t possiblaw-paperclip.XXXXXX.json)"
if [ -n "$TEAMS" ]; then
    SUBSET_SIDECAR_FILE="$(mktemp -t possiblaw-subset-sidecar.XXXXXX.yaml)"
    if ! python3 -c 'import json,sys; sys.stdout.write(json.load(open(sys.argv[1]))["source"]["files"][".paperclip.yaml"])' \
            "$INLINE_FILE" > "$SUBSET_SIDECAR_FILE"; then
        err "could not extract the filtered sidecar from the bundle"
        kill_paperclip_tree "$PAPERCLIP_PID"
        rm -f "$LAUNCHER_PID_FILE"
        exit 1
    fi
    yaml_to_json "$SUBSET_SIDECAR_FILE" > "$PAPERCLIP_JSON_FILE"
else
    yaml_to_json "$PAPERCLIP_YAML" > "$PAPERCLIP_JSON_FILE"
fi

OVERRIDES_FILE="$(mktemp -t possiblaw-overrides.XXXXXX.json)"
if ! python3 "$VARIANTS_PY" \
        --variants-json "$VARIANTS_JSON_FILE" \
        --paperclip-json "$PAPERCLIP_JSON_FILE" \
        --variant "$VARIANT" \
        > "$OVERRIDES_FILE"; then
    err "adapter override generation failed"
    kill_paperclip_tree "$PAPERCLIP_PID"
    rm -f "$LAUNCHER_PID_FILE"
    exit 1
fi

BODY_FILE="$(mktemp -t possiblaw-import-body.XXXXXX.json)"
python3 - "$INLINE_FILE" "$OVERRIDES_FILE" "$ORG_NAME" > "$BODY_FILE" <<'PY'
import json, sys
inline = json.load(open(sys.argv[1]))
overrides = json.load(open(sys.argv[2]))
org_name = sys.argv[3]
body = {
    "source": inline["source"],
    "target": {"mode": "new_company", "newCompanyName": org_name},
    "include": {"company": True, "agents": True, "projects": True, "issues": True, "skills": True},
    "collisionStrategy": "rename",
    "adapterOverrides": overrides,
}
json.dump(body, sys.stdout)
PY

BODY_SIZE="$(wc -c < "$BODY_FILE" | tr -d ' ')"
log "import body: $BODY_SIZE bytes ($(python3 -c "import json; d=json.load(open('$BODY_FILE')); print(len(d['adapterOverrides']))") agents)"

# ---------------------------------------------------------------------------
# POST /api/companies/import  (or /import/preview when --dry-run)
# ---------------------------------------------------------------------------

if [ "$DRY_RUN" = "true" ]; then
    IMPORT_URL="$API_BASE/api/companies/import/preview"
    milestone "POST $IMPORT_URL (dry-run)"
else
    IMPORT_URL="$API_BASE/api/companies/import"
    milestone "POST $IMPORT_URL"
fi

# Heartbeat: print elapsed seconds every 10s while the POST runs.
IMPORT_RESPONSE_FILE="$DATA_DIR/possiblaw-import.response"
IMPORT_ERR_FILE="$DATA_DIR/possiblaw-import.err"
IMPORT_STATUS_FILE="$DATA_DIR/possiblaw-import.status"
: > "$IMPORT_RESPONSE_FILE"; : > "$IMPORT_ERR_FILE"; : > "$IMPORT_STATUS_FILE"

(
    curl --silent --show-error \
         --max-time "$IMPORT_MAX_TIME_SECS" \
         --header "Content-Type: application/json" \
         --header "Connection: keep-alive" \
         --request POST \
         --data-binary "@$BODY_FILE" \
         --output "$IMPORT_RESPONSE_FILE" \
         --write-out '%{http_code}' \
         "$IMPORT_URL" \
         > "$IMPORT_STATUS_FILE" 2> "$IMPORT_ERR_FILE"
    echo $? > "$DATA_DIR/possiblaw-import.curl_exit"
) &
CURL_PID=$!

POST_START_EPOCH="$(date +%s)"
PARTIAL_CHECKED="false"
while kill -0 "$CURL_PID" 2>/dev/null; do
    sleep "$IMPORT_HEARTBEAT_SECS"
    ELAPSED_POST=$(( $(date +%s) - POST_START_EPOCH ))
    log "  ... import in progress (${ELAPSED_POST}s elapsed)"
    if [ "$PARTIAL_CHECKED" = "false" ] && [ "$ELAPSED_POST" -ge "$IMPORT_PARTIAL_CHECK_AFTER_SECS" ]; then
        PARTIAL_CHECKED="true"
        CUR_COUNT="$(
            curl --silent --max-time 5 "$API_BASE/api/companies" 2>/dev/null \
                | python3 -c "
import json, sys
try: d=json.load(sys.stdin)
except: print(0); sys.exit(0)
items = d if isinstance(d, list) else (d.get('companies') or d.get('data') or d.get('items') or [])
print(len(items) if isinstance(items, list) else 0)
" 2>/dev/null || echo 0
        )"
        log "  ... ${IMPORT_PARTIAL_CHECK_AFTER_SECS}s elapsed; $CUR_COUNT company(ies) currently in DB"
    fi
done
wait "$CURL_PID" || true

HTTP_CODE="$(cat "$IMPORT_STATUS_FILE" 2>/dev/null || echo 000)"
CURL_EXIT="$(cat "$DATA_DIR/possiblaw-import.curl_exit" 2>/dev/null || echo 99)"

if [ "$CURL_EXIT" != "0" ] || [ "$HTTP_CODE" != "200" ]; then
    err "import POST failed (curl exit $CURL_EXIT, HTTP $HTTP_CODE)"
    if [ -s "$IMPORT_ERR_FILE" ]; then
        err "stderr:"; sed 's/^/  /' "$IMPORT_ERR_FILE" >&2
    fi
    if [ -s "$IMPORT_RESPONSE_FILE" ]; then
        err "response (first 1KB):"; head -c 1024 "$IMPORT_RESPONSE_FILE" >&2; echo >&2
    fi
    kill_paperclip_tree "$PAPERCLIP_PID"
    rm -f "$LAUNCHER_PID_FILE"
    exit 1
fi
milestone "import POST returned HTTP 200"

# ---------------------------------------------------------------------------
# Parse import response
# ---------------------------------------------------------------------------

if [ "$DRY_RUN" = "true" ]; then
    # /import/preview returns plan + manifest + warnings + errors.
    PREVIEW_SUMMARY="$(python3 - "$IMPORT_RESPONSE_FILE" <<'PY'
import json, sys
doc = json.load(open(sys.argv[1]))
warnings = doc.get("warnings") or []
errors = doc.get("errors") or []
plan = (doc.get("plan") or {})
agents = plan.get("agentPlans") or []
projects = plan.get("projectPlans") or []
issues = plan.get("issuePlans") or []
manifest = doc.get("manifest") or {}
skills = manifest.get("skills") or []
print(f"agents={len(agents)} skills={len(skills)} projects={len(projects)} issues={len(issues)} warnings={len(warnings)} errors={len(errors)}")
for w in warnings: print(f"  warn: {w}")
for e in errors: print(f"  err:  {e}")
PY
)"
    log "preview: $PREVIEW_SUMMARY"
    milestone "dry-run complete; server still running (stop: kill \$(cat $LAUNCHER_PID_FILE))"
    # Keep server up so the operator can browse / re-run with no --dry-run.
    trap - INT TERM
    exit 0
fi

COMPANY_ID="$(json_get_str company.id < "$IMPORT_RESPONSE_FILE")"
AGENT_COUNT="$(python3 -c "import json; d=json.load(open('$IMPORT_RESPONSE_FILE')); print(len(d.get('agents') or []))")"
WARNING_COUNT="$(python3 -c "import json; d=json.load(open('$IMPORT_RESPONSE_FILE')); print(len(d.get('warnings') or []))")"
log "company id: $COMPANY_ID"
log "agents imported: $AGENT_COUNT"
log "warnings: $WARNING_COUNT"
if [ "$WARNING_COUNT" -gt 0 ]; then
    python3 -c "
import json
d=json.load(open('$IMPORT_RESPONSE_FILE'))
for w in (d.get('warnings') or []): print('  warn:', w)
"
fi

# Pull the company record so we get shortCode + final name.
COMPANIES_JSON="$(curl --silent --max-time 5 "$API_BASE/api/companies" || true)"
COMPANY_SHORT_CODE=""
COMPANY_NAME="$ORG_NAME"
if [ -n "$COMPANIES_JSON" ] && [ -n "$COMPANY_ID" ]; then
    LINE="$(printf '%s' "$COMPANIES_JSON" | python3 -c "
import json, sys
target_id = sys.argv[1]
try: d = json.load(sys.stdin)
except Exception: sys.exit(0)
items = d if isinstance(d, list) else (d.get('companies') or d.get('data') or d.get('items') or [])
for it in (items or []):
    if isinstance(it, dict) and (it.get('id') == target_id or it.get('companyId') == target_id):
        short = (it.get('shortCode') or it.get('short_code') or it.get('slug') or it.get('handle') or '')
        name = it.get('name') or ''
        print(f'{short}\t{name}'); break
" "$COMPANY_ID" 2>/dev/null || true)"
    if [ -n "$LINE" ]; then
        COMPANY_SHORT_CODE="$(printf '%s' "$LINE" | awk -F'\t' '{print $1}')"
        if [ -n "$(printf '%s' "$LINE" | awk -F'\t' '{print $2}')" ]; then
            COMPANY_NAME="$(printf '%s' "$LINE" | awk -F'\t' '{print $2}')"
        fi
    fi
fi

# ---------------------------------------------------------------------------
# PATCH mission as description
# ---------------------------------------------------------------------------

if [ -n "$COMPANY_ID" ] && [ -n "$MISSION" ]; then
    milestone "patching company description (mission)"
    PATCH_BODY="$(python3 -c "import json,sys; print(json.dumps({'description': sys.argv[1]}))" "$MISSION")"
    PATCH_RESPONSE="$DATA_DIR/possiblaw-patch.response"
    PATCH_HTTP="$(curl --silent --max-time 10 \
        --request PATCH \
        --header "Content-Type: application/json" \
        --data "$PATCH_BODY" \
        --output "$PATCH_RESPONSE" \
        --write-out '%{http_code}' \
        "$API_BASE/api/companies/$COMPANY_ID" || echo 000)"
    if [ "$PATCH_HTTP" = "200" ]; then
        log "  mission saved as company description"
    else
        warn "PATCH /api/companies/$COMPANY_ID returned HTTP $PATCH_HTTP"
        warn "Mission was not stored as company description. Response: $(head -c 256 "$PATCH_RESPONSE" 2>/dev/null)"
        warn "You can edit the description in the Paperclip UI."
    fi
fi

# ---------------------------------------------------------------------------
# Gate proxy (egress gates + receipts)
# ---------------------------------------------------------------------------
#
# Egress credentials (EGRESS_CRED_VARS) exist ONLY in this process tree: the
# paperclip server env was scrubbed at start because adapter-spawned agents
# inherit it wholesale. The proxy enforces gate-policy.yaml per boundary and
# appends a hash-chained receipt for every egress event. A proxy failure
# never blocks the dashboard — gate-dependent skills fail visibly instead.
#
# PAPERCLIP_GATE_API_KEY is intentionally NOT set here: local_trusted
# instances accept unauthenticated local board calls. Non-local-trusted
# deployments must export PAPERCLIP_GATE_API_KEY (minted via
# `paperclipai auth login`) before launching.

if [ "$NO_GATE_PROXY" = "true" ]; then
    warn "gate proxy disabled (--no-gate-proxy, demo-only): egress runs ungated and unreceipted"
elif [ -z "$COMPANY_ID" ]; then
    warn "no company id parsed from the import response; skipping the gate proxy"
elif [ -n "$(lsof -nP -iTCP:"$GATE_PORT" -sTCP:LISTEN -t 2>/dev/null || true)" ]; then
    warn "port $GATE_PORT is already in use; skipping gate-proxy start"
    warn "(stop the other process or re-run with --gate-port <n>)"
else
    GATE_START_OK="true"
    : > "$GATE_LOG"
    if [ ! -d "$REPO_ROOT/gate-proxy/node_modules" ]; then
        milestone "installing gate-proxy dependencies (first run)"
        if ! pnpm -C "$REPO_ROOT/gate-proxy" install >>"$GATE_LOG" 2>&1; then
            warn "gate-proxy dependency install failed (log: $GATE_LOG); continuing without the gate proxy"
            GATE_START_OK="false"
        fi
    fi
    if [ "$GATE_START_OK" = "true" ]; then
        milestone "starting gate proxy on $GATE_PROXY_URL (log: $GATE_LOG)"
        mkdir -p "$(dirname "$GATE_RECEIPTS_PATH")" "$HOME/.possiblaw/action-packages"
        # Operator-exported egress creds (EGRESS_CRED_VARS) plus
        # LOCAL_MODEL_URL / EXTERNAL_MODEL_URL pass through by inheritance —
        # this is the ONLY child process the launcher starts without the scrub.
        (
            exec env \
                GATE_PROXY_PORT="$GATE_PORT" \
                GATE_POLICY_PATH="$REPO_ROOT/companies/legal-operations/gate-policy.yaml" \
                GATE_RECEIPTS_PATH="$GATE_RECEIPTS_PATH" \
                PAPERCLIP_BASE_URL="$API_BASE" \
                PAPERCLIP_COMPANY_ID="$COMPANY_ID" \
                GATE_ACTION_PACKAGE_DIR="$HOME/.possiblaw/action-packages" \
                pnpm -C "$REPO_ROOT/gate-proxy" start
        ) >>"$GATE_LOG" 2>&1 </dev/null &
        GATE_PROXY_PID=$!
        echo "$GATE_PROXY_PID" > "$GATE_PID_FILE"

        GATE_WAITED=0
        GATE_HEALTHY="false"
        while [ "$GATE_WAITED" -lt "$GATE_HEALTH_TIMEOUT_SECS" ]; do
            if ! kill -0 "$GATE_PROXY_PID" 2>/dev/null; then break; fi
            GATE_HTTP_CODE="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 2 "$GATE_PROXY_URL/health" || true)"
            if [ "$GATE_HTTP_CODE" = "200" ]; then GATE_HEALTHY="true"; break; fi
            sleep 1
            GATE_WAITED=$(( GATE_WAITED + 1 ))
        done
        if [ "$GATE_HEALTHY" = "true" ]; then
            # Replace the subshell PID with the actual listener PID so
            # `kill $(cat gate-proxy.pid)` does the right thing.
            GATE_LISTEN_PID="$(lsof -nP -iTCP:"$GATE_PORT" -sTCP:LISTEN -t 2>/dev/null | head -n 1 || true)"
            if [ -n "$GATE_LISTEN_PID" ]; then
                echo "$GATE_LISTEN_PID" > "$GATE_PID_FILE"
            fi
            milestone "gate proxy healthy at $GATE_PROXY_URL (receipts: $GATE_RECEIPTS_PATH)"
        elif kill -0 "$GATE_PROXY_PID" 2>/dev/null; then
            warn "gate proxy not healthy after ${GATE_HEALTH_TIMEOUT_SECS}s — continuing; gate-dependent"
            warn "skills will fail visibly until it comes up (log: $GATE_LOG)"
        else
            warn "gate proxy exited during startup — continuing; gate-dependent skills will fail visibly"
            tail -n 20 "$GATE_LOG" >&2 || true
            rm -f "$GATE_PID_FILE"
            GATE_PROXY_PID=""
        fi
    fi
fi

# ---------------------------------------------------------------------------
# Bind per-agent env: API-key secret_refs (dual-auth) + GATE_PROXY_URL
# ---------------------------------------------------------------------------
#
# For *-api variants: store each declared key ONCE as a paperclip company
# secret, then PATCH every imported agent so its adapterConfig.env references
# the secret (type: secret_ref). The raw key is passed to helpers via child
# process env and to curl via stdin — never argv, never a file on disk.
# Unless --no-gate-proxy, the same PATCH binds GATE_PROXY_URL (a plain
# loopback address, not a credential) so every agent egresses via the proxy.

SECRET_BIND_FAILED="false"
SECRET_IDS_FILE="$(mktemp -t possiblaw-secret-ids.XXXXXX.json)"
printf '{}' > "$SECRET_IDS_FILE"
if [ -n "$SECRET_ENV_TSV" ] && [ -n "$COMPANY_ID" ]; then
    milestone "creating company secret(s) for the API key(s)"
    while IFS=$'\t' read -r env_key env_name; do
        [ -n "$env_key" ] || continue
        if [ -z "${!env_key:-}" ]; then
            warn "\$$env_key vanished from the environment; skipping secret creation"
            SECRET_BIND_FAILED="true"
            continue
        fi
        SECRET_BODY="$(PCSECRET_VALUE="${!env_key}" PCSECRET_KEY="$env_key" PCSECRET_NAME="$env_name" python3 -c '
import json, os
print(json.dumps({
    "name": os.environ["PCSECRET_NAME"],
    "key": os.environ["PCSECRET_KEY"],
    "value": os.environ["PCSECRET_VALUE"],
    "description": "Created by bin/possiblaw for the API-key variant",
}))')"
        SECRET_RESPONSE="$(printf '%s' "$SECRET_BODY" | curl --silent --max-time 15 \
            --request POST \
            --header "Content-Type: application/json" \
            --data-binary @- \
            "$API_BASE/api/companies/$COMPANY_ID/secrets" || true)"
        SECRET_ID="$(printf '%s' "$SECRET_RESPONSE" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
print(d.get("id") or "")' 2>/dev/null || true)"
        if [ -z "$SECRET_ID" ]; then
            warn "could not create company secret for \$$env_key"
            warn "response: $(printf '%s' "$SECRET_RESPONSE" | head -c 200)"
            SECRET_BIND_FAILED="true"
            continue
        fi
        log "  secret created: $env_name (id $SECRET_ID)"
        python3 - "$SECRET_IDS_FILE" "$env_key" "$SECRET_ID" <<'PY'
import json, sys
path, key, sid = sys.argv[1:4]
d = json.load(open(path))
d[key] = sid
json.dump(d, open(path, "w"))
PY
    done <<< "$SECRET_ENV_TSV"
fi

PLAIN_ENV_FILE="$(mktemp -t possiblaw-plain-env.XXXXXX.json)"
if [ "$NO_GATE_PROXY" = "true" ]; then
    printf '{}' > "$PLAIN_ENV_FILE"
else
    printf '{"GATE_PROXY_URL": "%s"}' "$GATE_PROXY_URL" > "$PLAIN_ENV_FILE"
fi
# If --business was given, inject POSSIBLAW_BUSINESS_DIR into every agent's env.
if [ -n "$BUSINESS_DIR" ]; then
    python3 - "$PLAIN_ENV_FILE" "$BUSINESS_DIR" <<'PY'
import json, sys
path, bdir = sys.argv[1], sys.argv[2]
d = json.load(open(path))
d["POSSIBLAW_BUSINESS_DIR"] = bdir
json.dump(d, open(path, "w"))
PY
fi

if [ -n "$COMPANY_ID" ] && { [ -n "$SECRET_ENV_TSV" ] || [ "$NO_GATE_PROXY" != "true" ] || [ -n "$BUSINESS_DIR" ]; }; then
    milestone "binding adapter env to agents (API-key secret_refs + GATE_PROXY_URL)"
    PATCHES_FILE="$(mktemp -t possiblaw-env-patches.XXXXXX.json)"
    if ! python3 "$VARIANTS_PY" --build-env-patches \
            --overrides-json "$OVERRIDES_FILE" \
            --secret-ids-json "$SECRET_IDS_FILE" \
            --plain-env-json "$PLAIN_ENV_FILE" > "$PATCHES_FILE"; then
        warn "env patch generation failed; agents keep their import-time adapter config"
        SECRET_BIND_FAILED="true"
    else
        PATCHED=0; PATCH_FAILED=0
        while IFS=$'\t' read -r agent_slug agent_id; do
            { [ -n "$agent_slug" ] && [ -n "$agent_id" ]; } || continue
            AGENT_PATCH_BODY="$(python3 - "$PATCHES_FILE" "$agent_slug" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
entry = d.get(sys.argv[2])
print(json.dumps(entry) if entry else "")
PY
)"
            [ -n "$AGENT_PATCH_BODY" ] || continue
            PATCH_HTTP_CODE="$(printf '%s' "$AGENT_PATCH_BODY" | curl --silent --output /dev/null --write-out '%{http_code}' --max-time 15 \
                --request PATCH \
                --header "Content-Type: application/json" \
                --data-binary @- \
                "$API_BASE/api/agents/$agent_id" || echo 000)"
            if [ "$PATCH_HTTP_CODE" = "200" ]; then
                PATCHED=$((PATCHED + 1))
            else
                PATCH_FAILED=$((PATCH_FAILED + 1))
                warn "  PATCH /api/agents/$agent_id ($agent_slug) returned HTTP $PATCH_HTTP_CODE"
            fi
        done < <(python3 - "$IMPORT_RESPONSE_FILE" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
for a in (d.get("agents") or []):
    slug = a.get("slug") or ""
    aid = a.get("id") or ""
    if slug and aid:
        print(f"{slug}\t{aid}")
PY
)
        log "  adapter env bound on $PATCHED agent(s)"
        if [ "$PATCH_FAILED" -gt 0 ]; then
            warn "  $PATCH_FAILED agent(s) could not be patched; set the env in the"
            warn "  Paperclip UI instead (agent settings → adapter config → env)."
            SECRET_BIND_FAILED="true"
        fi
    fi
    rm -f "$PATCHES_FILE"
    if [ "$SECRET_BIND_FAILED" = "true" ]; then
        warn "env binding incomplete — affected agents keep their import-time adapter config."
    fi
fi
rm -f "$SECRET_IDS_FILE" "$PLAIN_ENV_FILE"

# ---------------------------------------------------------------------------
# Final banner + browser open
# ---------------------------------------------------------------------------

DASHBOARD_URL="$API_BASE"
if [ -n "$COMPANY_SHORT_CODE" ]; then
    DASHBOARD_URL="$API_BASE/$COMPANY_SHORT_CODE/dashboard"
fi

printf '\n'
printf '======================================================================\n'
printf '  PossibLaw is ready (%ss to first ready)\n' "$(( $(date +%s) - LAUNCH_START_EPOCH ))"
printf '======================================================================\n'
printf '  Company:    %s\n' "$COMPANY_NAME"
[ -n "$COMPANY_ID" ] && printf '  Company id: %s\n' "$COMPANY_ID"
printf '  Variant:    %s (%s)\n' "$VARIANT" "$(variant_label "$VARIANT")"
printf '  Agents:     %s\n' "$AGENT_COUNT"
printf '  Dashboard:  %s\n' "$DASHBOARD_URL"
printf '  Data dir:   %s\n' "$DATA_DIR"
printf '  Server log: %s\n' "$LAUNCHER_LOG"
printf '  Server pid: %s (saved to %s)\n' "${SERVER_PID:-$PAPERCLIP_PID}" "$LAUNCHER_PID_FILE"
if [ -n "$GATE_PROXY_PID" ]; then
    printf '  Gate proxy: %s (pid saved to %s)\n' "$GATE_PROXY_URL" "$GATE_PID_FILE"
    printf '  Receipts:   %s\n' "$GATE_RECEIPTS_PATH"
fi
printf '\n'
printf '  Tail the log:    tail -f %s\n' "$LAUNCHER_LOG"
printf '  Stop the server: kill $(cat %s)\n' "$LAUNCHER_PID_FILE"
if [ -n "$GATE_PROXY_PID" ]; then
    printf '  Stop the proxy:  kill $(cat %s)\n' "$GATE_PID_FILE"
fi
printf '\n'
printf '  Operator walkthrough: %s/docs/operator-walkthrough.md\n' "$REPO_ROOT"
printf '======================================================================\n'

maybe_morning_review() {
    [ -n "$BUSINESS_DIR" ] || return 0
    local today marker pending
    today="$(date '+%Y%m%d')"
    marker="$BUSINESS_DIR/.last-review-$today"
    [ -e "$marker" ] && return 0
    pending="$( (cd "$REPO_ROOT/learning-loop" && node --import tsx src/cli.ts review-list --business "$BUSINESS_DIR") 2>/dev/null )" || pending=""
    if [ "$pending" = "[]" ] || [ -z "$pending" ]; then
        : # no pending proposals
    else
        printf '\n=== Skill-improvement review (%s) ===\n' "$today"
        printf '%s\n' "$pending" | python3 "$REPO_ROOT/bin/_possiblaw_review_print.py"
        printf 'Review each in the PossibLaw app or run:\n'
        printf '  (cd learning-loop && node --import tsx src/cli.ts approve-edit --business "%s" --id <SEP-id>)\n' "$BUSINESS_DIR"
        printf '  (cd learning-loop && node --import tsx src/cli.ts reject-edit  --business "%s" --id <SEP-id>)\n' "$BUSINESS_DIR"
    fi
    : > "$marker"
}
maybe_morning_review || true

if [ "$NO_BROWSER" != "true" ]; then
    if command -v open >/dev/null 2>&1; then
        open "$DASHBOARD_URL" 2>/dev/null || true
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$DASHBOARD_URL" 2>/dev/null || true
    fi
fi

# Detach trap — leaving the server running intentionally.
trap - INT TERM

exit 0
