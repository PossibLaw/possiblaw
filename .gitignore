pnpm-store/

# Audit logs are per-matter runtime artifacts, not source
layer/audit/*.jsonl
!layer/audit/.gitkeep

# Per-operator model overrides (not committed)
.possiblaw/

# Privacy Filter per-matter key stores (sensitive — never commit)
layer/privacy-filter/keys/

# Eval dataset caches — fetched on demand, not redistributed in-tree
layer/evals/datasets/cuad/cache/samples.jsonl
layer/evals/datasets/maud/cache/samples.jsonl
layer/evals/datasets/acord/cache/samples.jsonl
layer/evals/datasets/unfair-tos/cache/samples.jsonl
layer/evals/datasets/ledgar/cache/samples.jsonl

# Eval results — runtime artifacts, not source
layer/evals/results/*.json
layer/evals/results/*.md

# Stray local clones / caches (never tracked)
/possiblaw/
/.agents/
/.pnpm-store/

# Eval harness run outputs (runtime artifacts, not source)
/eval-harness/results/

# Subagent-driven-development progress ledger (local scratch)
/.superpowers/

# Local agent continuity files (keep local; do not commit)
.claude/history.md
.agent/PLAN.md
.agent/CONTEXT.md
.agent/TASKS.md
.agent/REVIEW.md
.agent/TEST.md
.agent/HANDOFF.md
.agent/WIKI.md
.agent/LEARNINGS.md

# Per-business learning stores: keep only the template in the canonical repo;
# a firm un-ignores its own dir in its clone.
/businesses/*
!/businesses/_template/
!/businesses/_template/**

# Timestamped instruction-file backups (redundant with git history)
*.bak.[0-9]*

# machine-local artifacts
.mcp.json
