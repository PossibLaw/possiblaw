PAPERCLIP_GATE_AGENT_ID=replace-with-dedicated-gate-agent-id
WORKER_A_AGENT_ID=replace-with-sacrificial-or-specialist-agent-id
WORKER_B_AGENT_ID=replace-with-second-agent-id
