# PossibLaw environment variables
# Copy to .env and fill in the values you need.
# Stand-in connectors (local-fs-doc-store, no-op-signature, courtlistener) require NO env vars.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Required for live LLM calls via Anthropic. NOT REQUIRED for offline demo.
ANTHROPIC_API_KEY=

# Optional: Ollama host (default: http://localhost:11434). Used for local models.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# ---------------------------------------------------------------------------
# Connector: Stripe (business / open-access — free dev tier available)
# ---------------------------------------------------------------------------
# NOT REQUIRED for offline demo. Use test key sk_test_... for dev.
# From: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=

# ---------------------------------------------------------------------------
# Connector: midpage (legal / paid — anticipated schema, UNCONFIRMED)
# ---------------------------------------------------------------------------
# NOT REQUIRED for offline demo. Contact midpage.ai for API access.
# See cli/connectors/midpage.README.md for reconciliation notes.
MIDPAGE_API_KEY=

# ---------------------------------------------------------------------------
# Connector: DocuSign (legal / paid — enterprise e-signature)
# ---------------------------------------------------------------------------
# NOT REQUIRED for offline demo. All five vars required for live DocuSign use.
# See: https://developers.docusign.com/platform/auth/jwt-get-token/

# App integration key from DocuSign developer console
DOCUSIGN_INTEGRATION_KEY=

# DocuSign user GUID (impersonated user)
DOCUSIGN_USER_ID=

# DocuSign account GUID
DOCUSIGN_ACCOUNT_ID=

# Absolute path to RSA private key PEM file for JWT auth
DOCUSIGN_PRIVATE_KEY_PATH=

# API base path (optional — defaults to sandbox: https://demo.docusign.net/restapi)
# For production: https://na4.docusign.net/restapi  (region varies)
# DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi

# ---------------------------------------------------------------------------
# Connector: CourtListener (stand-in / open-access — optional key for higher limits)
# ---------------------------------------------------------------------------
# NOT REQUIRED. Omit for anonymous low-volume access.
# Create a free account at: https://www.courtlistener.com/register/
# COURTLISTENER_API_KEY=

# ---------------------------------------------------------------------------
# Connector: iManage (legal / paid — enterprise DMS)
# ---------------------------------------------------------------------------
# NOT REQUIRED for offline demo. Requires iManage Work subscription.
# Bearer-token flow implemented. For OAuth setup see cli/connectors/imanage.README.md.
IMANAGE_HOST=
IMANAGE_LIBRARY=
IMANAGE_TOKEN=

# ---------------------------------------------------------------------------
# Connector: NetDocuments (legal / paid — cloud DMS)
# ---------------------------------------------------------------------------
# NOT REQUIRED for offline demo. Requires NetDocuments subscription + API access.
NETDOCS_HOST=
NETDOCS_REPOSITORY_ID=
NETDOCS_OAUTH_TOKEN=

# ---------------------------------------------------------------------------
# Connector: Westlaw (legal / paid — UNCONFIRMED endpoint; enterprise TR contract)
# ---------------------------------------------------------------------------
# NOT REQUIRED for offline demo. See cli/connectors/westlaw.README.md.
# Base URL https://api.westlaw.com/v1/ is a PLACEHOLDER — verify with TR.
WESTLAW_API_KEY=
WESTLAW_USER_ID=

# ---------------------------------------------------------------------------
# Connector: Lexis (legal / paid — UNCONFIRMED endpoint; enterprise LN contract)
# ---------------------------------------------------------------------------
# NOT REQUIRED for offline demo. See cli/connectors/lexis.README.md.
# Base URL https://api.lexis.com/v1/ is a PLACEHOLDER — verify with LexisNexis.
LEXIS_API_KEY=
LEXIS_USER_ID=

# ---------------------------------------------------------------------------
# Connector: QuickBooks (business / open-access — free Intuit Developer sandbox)
# ---------------------------------------------------------------------------
# NOT REQUIRED for offline demo. Use sandbox by default (QB_USE_SANDBOX=true).
# From: https://developer.intuit.com/app/developer/qbo/docs/develop
QB_CONSUMER_KEY=
QB_CONSUMER_SECRET=
QB_TOKEN=
QB_TOKEN_SECRET=
QB_REALM_ID=
# QB_USE_SANDBOX=true   # default: true (sandbox). Set to false for production.

# ---------------------------------------------------------------------------
# Connector: HubSpot (business / open-access — free HubSpot developer account)
# ---------------------------------------------------------------------------
# NOT REQUIRED for offline demo. Create a private app at:
# https://app.hubspot.com/settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Connector: Notion (business / open-access — free for personal/dev use)
# ---------------------------------------------------------------------------
# NOT REQUIRED for offline demo. Create an integration at:
# https://www.notion.so/my-integrations
NOTION_API_KEY=

# ---------------------------------------------------------------------------
# Connector: Linear (business / open-access — free dev account)
# ---------------------------------------------------------------------------
# NOT REQUIRED for offline demo. Generate at:
# Linear Settings → API → Personal API keys
LINEAR_API_KEY=
