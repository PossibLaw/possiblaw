{
  "name": "possiblaw",
  "version": "0.1.0",
  "description": "Proof-of-concept layer on paperclip for operating a legal business with AI",
  "license": "Apache-2.0",
  "private": true,
  "keywords": ["legal-tech", "ai-agents", "legal-ai", "proof-of-concept", "paperclip-layer", "mcp"],
  "repository": {
    "type": "git",
    "url": "https://github.com/PossibLaw/possiblaw.git"
  },
  "homepage": "https://github.com/PossibLaw/possiblaw#readme",
  "bugs": {
    "url": "https://github.com/PossibLaw/possiblaw/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.10"
  },
  "bin": {
    "possiblaw": "bin/possiblaw"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/cli/fixtures && cp cli/fixtures/* dist/cli/fixtures/ && mkdir -p dist/layer/evals/datasets/cuad && cp layer/evals/datasets/cuad/fixtures.jsonl dist/layer/evals/datasets/cuad/ && mkdir -p layer/evals/results",
    "dev": "tsx cli/index.ts",
    "possiblaw": "node dist/cli/index.js",
    "lint": "echo 'no lint configured yet — placeholder'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'no tests configured yet — placeholder'",
    "test:llm-providers": "tsx cli/__tests__/llm-providers.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30",
    "@hubspot/api-client": "^11",
    "@linear/sdk": "^29",
    "@notionhq/client": "^2",
    "commander": "^12",
    "docusign-esign": "^6",
    "gray-matter": "^4",
    "js-yaml": "^4",
    "node-quickbooks": "^2",
    "stripe": "^17"
  },
  "devDependencies": {
    "@types/docusign-esign": "^5",
    "@types/js-yaml": "^4",
    "@types/node": "^20",
    "tsx": "^4",
    "typescript": "^5.4"
  }
}
